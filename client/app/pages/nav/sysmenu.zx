// The system card: a gear at the top bar's far right and a compact card dropping from under it. It
// reaches the three app-wide panels the drawers do not carry, Look, Settings and Extensions, through
// the switcher across its top. Opening it closes the bell's card (topbar_menus.zig).
//
// IT IS DELIBERATELY NOT FULL-SCREEN, and that is the whole point of the component. Every control in
// it changes how the app LOOKS, and a menu that covers the app hides the thing being judged. So the
// card is capped at 336px wide and at 28rem tall, its BODY scrolls rather than the card growing, and
// a background, colour or motion change repaints the conversation that stays visible behind it.
//
// The bodies it shows are the real panels (system/*.zx), not a summary of them: the same forms the
// old top drawer carried, laid out to wrap at this width.
pub fn SysMenu(allocator: zx.Allocator) zx.Component {
    return (
        <button
            @allocator={allocator}
            id="sys-gear"
            type="button"
            class={gear}
            data-icon="cog"
            aria-label="System"
            aria-haspopup="dialog"
            aria-expanded={if (state.isOpen()) "true" else "false"}
            aria-controls={if (state.isMounted()) "sys-popover" else ""}
            onclick={menus.onGear}
        ></button>
    );
}

/// The card. Mounted by shell.zx OUTSIDE the top bar, for the stacking-context reason spelled out in
/// notify_bell.zx: nested in #topbar (z-20) it would paint under the z-40 docks whatever z it asked
/// for, and clicks meant for it would land on the dock behind.
pub fn SysPopover(allocator: zx.Allocator) zx.Component {
    return (
        <div @allocator={allocator} class="sysmenu-mount">
            {if (state.isMounted()) (
                <div
                    id="sys-popover"
                    class={if (state.isClosing()) popover_out else popover_in}
                    role="dialog"
                    aria-labelledby="sys-heading"
                    tabindex="-1"
                    onkeydown={state.onKey}
                >
                    <div class="sysmenu-head">
                        <h2 id="sys-heading" class={heading}>System</h2>
                        <button
                            type="button"
                            class={close_btn}
                            data-icon="close"
                            aria-label="Close system menu"
                            onclick={state.onClose}
                        ></button>
                    </div>

                    <SysSections />

                    <div class={body} data-sys-body={model.sectionTag(state.section())}>
                        {if (state.section() == .look) (
                            <div class="sysmenu-look">
                                <div class="sysmenu-group">
                                    <span class={group_label}>Motion</span>
                                    <div class="sysmenu-seg-row">
                                        {for (motion_opts_slice) |m| (
                                            <button
                                                type="button"
                                                class={seg}
                                                data-motion-set={m.value}
                                                aria-pressed={if (ui.motionPref() == m.pref) "true" else "false"}
                                                onclick={state.onMotion}
                                            >{m.label}</button>
                                        )}
                                    </div>
                                </div>
                                <div class="sysmenu-group">
                                    <span class={group_label}>Background</span>
                                    <BackgroundsBody />
                                </div>
                            </div>
                        ) else if (state.section() == .settings) (
                            <SettingsBody />
                        ) else (
                            <ExtensionsBody />
                        )}
                    </div>

                    <p class={note}>Changes land on the page behind this card.</p>
                </div>
            )}
        </div>
    );
}

// The bell's twin, at the bar's far right. It grows to the 44px tap minimum on a coarse pointer,
// which is what --topbar-h yields 3rem for on mobile: a 2.6rem bar could not hold one (WD35).
const gear = "icon sysmenu-gear";

// 464px wide and 28rem tall at most, dropped from under the bar's right edge. It was 336px, where
// every reading row wrapped its label above its buttons and the four-button groups (Layout, Avatar
// size) wrapped again inside themselves, costing three lines each; 29rem fits the widest group on one
// line and still leaves the conversation readable beside it. Both caps yield to the viewport so the
// card can never run off a small window. No shadow: this theme
// carries depth on borders (WD16). Padding lives on the head, body and footer, not here, so the
// body's scrollbar rides the card edge instead of floating inside a gutter. z-[70] clears both dock
// layers, which only holds because shell.zx mounts this outside #topbar's stacking context.
// Three literals rather than a computed string: the tailwind scanner reads .zx TEXT, so the
// animate-* utilities have to appear here as literals to be generated. It DROPS on `drawer-in`, the
// bell card's animation rather than the `pop-in` it used when the gear sat in the bottom corner: a
// card that rose from below a top-bar button read as coming from the wrong place.
const popover_base = "sysmenu-popover";
const popover_in = popover_base ++ " nav-popover-in";
const popover_out = popover_base ++ " nav-popover-out";

const heading = "sysmenu-heading";

const close_btn = "icon sysmenu-close";

// The one scrolling region. The card holds its size and this grows a scrollbar, which is what keeps
// a full-size form from turning the card into the overlay it must not be. It carries data-sys-body,
// which names the group currently mounted: the browser gate drives this card through that attribute
// and the three body ids, so neither depends on a class or on visible text surviving a restyle.
const body = "sysmenu-body";

const group_label = "sysmenu-group-label";

const note = "sysmenu-note";

// The segmented motion control. Its selected look rides aria-pressed, which the button carries for
// assistive tech anyway, so no class is computed for state.
const seg = "sysmenu-seg";

const MotionOpt = struct { pref: ui.MotionPref, value: []const u8, label: []const u8 };
const motion_opts = [_]MotionOpt{
    .{ .pref = .system, .value = "system", .label = "System" },
    .{ .pref = .on, .value = "on", .label = "Full" },
    .{ .pref = .off, .value = "off", .label = "Still" },
};
// ZX1: a {for} target must already be a slice.
const motion_opts_slice: []const MotionOpt = &motion_opts;

const zx = @import("zx");
const ui = @import("./ui.zig");
const state = @import("./sysmenu_state.zig");
const menus = @import("../shell/topbar_menus.zig");
const model = @import("./sysmenu_model.zig");
const SysSections = @import("./sysmenu_sections.zx").SysSections;
const SettingsBody = @import("../system/settings_body.zx").SettingsBody;
const BackgroundsBody = @import("../system/backgrounds_body.zx").BackgroundsBody;
const ExtensionsBody = @import("../system/extensions_body.zx").ExtensionsBody;
