// A compact status chip that lives in the top bar, left of the notification bell. Shows a coloured
// dot driven by the same data-conn-state attribute the connections panel uses (app-input.css), plus
// the model name or a short status line. Clicking opens the system gear to the connections panel.
pub fn StatusIndicator(allocator: zx.Allocator) zx.Component {
    const model = connection.statusModel();
    const label = if (model.len > 0) model else connection.statusWords(&word_buf);
    return (
        <div
            @allocator={allocator}
            class="flex flex-none items-center gap-1.5 rounded-md border border-border bg-surface-2 px-2 py-1"
            data-conn-state={connection.stateName()}
        >
            <span class="conn-dot flex-none" aria-hidden="true"></span>
            <span class="max-w-[7rem] truncate font-mono text-[0.62rem] leading-ui text-muted">{label}</span>
        </div>
    );
}

var word_buf: [96]u8 = undefined;

const zx = @import("zx");
const connection = @import("./connection.zig");
