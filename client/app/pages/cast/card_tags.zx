// Tag assignment for the character whose card is open: create a tag, colour it, put it on this
// character or take it off. Rendered inside the card editor (card_editor_body.zx), which is where a
// statement about ONE character belongs; the character list's toolbar now only filters.
//
// "YOUR TAGS", not "Tags": the card carries a Tags field of its own a few rows up (card_form's
// `tags` spec, the comma-separated list inside the card file), and two headings reading the same
// word in one scroll is a panel asking the user to guess which one it means. These are the ACCOUNT
// tags, stored in the settings blob and never written into the card.
//
// TWO TAG SYSTEMS, and the copy here says only what the code does. THESE (settings `tags` +
// `tag_map`) reach one consumer: world info's characterFilter (char_api.zig:1951 ->
// generate.zig char_tags). The character list's filter bar reads the OTHER set, the card's own
// `tags` array off /api/characters/all (character_view.compute -> tags_all). Assigning here
// therefore does NOT add a chip to that bar today. Surfaced to the lead rather than unified here:
// joining them changes what the list filters on, which is a product decision, not a refactor.
//
// The data model and the blob shape live in tag_store.zig (pure, natively tested), unchanged by the
// move. Every mutation queues reading_prefs' ONE debounced saver, so the `tags` + `tag_map` keys
// persist without a second read-modify-write clobbering the blob.
//
// SUBJECT: the avatar the editor is holding (card_editor.editingAvatar), which is the card on
// screen, so the assignment cannot land on a character the user is not looking at.

pub fn CardTags(allocator: zx.Allocator) zx.Component {
    const avatar = card_editor.editingAvatar();
    // allow-div-onclick: delegation root for the row buttons' data-* controls (ZX11 walks up from
    // the event target); every control inside is a real button or input.
    return (
        <div
            @allocator={allocator}
            class="card-tags flex flex-col gap-2"
            onclick={&onTagsClick}
        >
            <span class="setting-label text-base font-medium max-[768px]:text-[0.88rem]">Your tags</span>
            <p class="setting-note m-0 text-sm text-muted max-[768px]:text-[0.78rem]" id="card-tags-hint">Not the card's Tags field above: these live in your settings, never in the card file, and world info entries can filter on them.</p>
            <div class="flex items-center gap-2">
                <input
                    type="text"
                    id="tag-create-name"
                    name="tag-create-name"
                    class={create_input}
                    aria-label="New tag name"
                    aria-describedby="card-tags-hint"
                    autocomplete="off"
                    placeholder="New tag..."
                    onkeydown={&onCreateKey}
                />
                <button type="button" class={action_btn} data-tag-create="1">Add</button>
            </div>
            {for (tag_store.global.tags.items) |t| (
                <div class="tag-row flex items-center gap-2">
                    <span class="tag-row-name flex-1 truncate text-sm text-text">{t.name}</span>
                    <input
                        type="color"
                        class="tag-color size-6 flex-none cursor-pointer rounded-sm border border-control-border bg-transparent p-0"
                        name="tag-color"
                        aria-label={colorLabel(allocator, t.name)}
                        value={if (t.color.len > 0) t.color else default_color}
                        data-tag-color={t.id}
                        onchange={&onColorChange}
                    />
                    { if (avatar.len > 0) (
                        <button
                            type="button"
                            class={action_btn}
                            data-tag-assign={t.id}
                            aria-pressed={if (tag_store.global.isAssigned(avatar, t.id)) "true" else "false"}
                            aria-label={assignLabel(allocator, t.name, tag_store.global.isAssigned(avatar, t.id))}
                        >{if (tag_store.global.isAssigned(avatar, t.id)) "Untag" else "Tag"}</button>
                    ) }
                </div>
            )}
            { if (tag_store.global.tags.items.len == 0) (
                <p class="m-0 text-sm text-muted">No tags yet. Name one above and you can put it on this character.</p>
            ) }
        </div>
    );
}

// card_editor_body.zx's own control classes, matched so the section reads as part of the card
// rather than as a panel that wandered in from somewhere else. Copied, not imported: this file is a
// CHILD of that one, and a .zx import cycle is transpiler territory not worth probing.
const action_btn = "cursor-pointer rounded-md border border-control-border bg-surface-2 px-3 py-1 font-mono text-sm text-muted transition-colors duration-120 ease-[ease] hover:text-text aria-pressed:border-accent aria-pressed:text-text";
const create_input = "min-w-0 flex-1 rounded-md border border-control-border bg-bg px-3 py-2 font-mono text-sm text-text transition-[border-color] duration-120 ease-[ease] placeholder:text-faint focus:border-accent focus:not-focus-visible:outline-none";
/// The swatch a colourless tag opens on: the theme's own amber, so a first pick starts from the
/// app's palette instead of the colour picker's stock red.
const default_color = "#8a7a5c";

/// "Colour for harbor", not "Tag colour" repeated down the column (WD38).
fn colorLabel(arena: std.mem.Allocator, name: []const u8) []const u8 {
    return std.fmt.allocPrint(arena, "Colour for {s}", .{name}) catch "Tag colour";
}

/// Every button in the column reads "Tag" or "Untag", so each needs the tag's name in its
/// accessible name or a screen reader hears the same word N times (WD38).
fn assignLabel(arena: std.mem.Allocator, name: []const u8, assigned: bool) []const u8 {
    const verb = if (assigned) "Remove tag" else "Add tag";
    return std.fmt.allocPrint(arena, "{s} {s}", .{ verb, name }) catch verb;
}

fn onTagsClick(ev: zx.client.Event) void {
    if (zx.platform.role != .client) return;
    const target = dom_event.plainTarget(ev) orelse return;

    if (dom_event.datasetUp(target, "tagCreate")) |flag| {
        zx.allocator.free(flag);
        ev.stopPropagation();
        createFromInput();
        return;
    }
    if (dom_event.datasetUp(target, "tagAssign")) |id| {
        defer zx.allocator.free(id);
        ev.stopPropagation();
        toggleAssign(id);
        return;
    }
}

/// Enter in the name field adds the tag, because a one-field row with a button beside it is a form
/// in every way but the tag name, and a user who types a name and presses Enter is not wrong. The
/// key is consumed: ui.onPageKey would otherwise see nothing to do with it, but a bare Enter inside
/// a panel is exactly the sort of key another handler picks up later.
fn onCreateKey(ev: zx.client.Event) void {
    if (zx.platform.role != .client) return;
    const key = ev.key() orelse return;
    defer zx.allocator.free(key);
    if (!std.mem.eql(u8, key, "Enter")) return;
    ev.preventDefault();
    ev.stopPropagation();
    createFromInput();
}

fn createFromInput() void {
    const el = dom_event.elementById(alloc, "tag-create-name") orelse return;
    defer el.deinit();
    const raw = el.ref.getAlloc(js.String, alloc, "value") catch return;
    defer alloc.free(raw);
    const name = std.mem.trim(u8, raw, " \t\r\n");
    if (name.len == 0) return;
    // The id is name-derived: `create` dedups by name, so the pair stays unique without a clock.
    const id = std.fmt.allocPrint(alloc, "t-{s}", .{name}) catch return;
    defer alloc.free(id);
    _ = tag_store.global.create(id, name) catch |err| {
        log.err("tag create failed: {s}", .{@errorName(err)});
        return;
    };
    el.ref.set("value", js.string("")) catch {};
    reading_prefs.scheduleSave();
    regions.bumpShell();
    log.debug("tag created: {s}", .{name});
}

fn toggleAssign(id: []const u8) void {
    const avatar = card_editor.editingAvatar();
    if (avatar.len == 0) return;
    if (tag_store.global.isAssigned(avatar, id)) {
        tag_store.global.unassign(avatar, id);
    } else {
        tag_store.global.assign(avatar, id) catch |err| {
            log.err("tag assign failed: {s}", .{@errorName(err)});
            return;
        };
    }
    reading_prefs.scheduleSave();
    regions.bumpShell();
}

fn onColorChange(ev: zx.client.Event) void {
    if (zx.platform.role != .client) return;
    const target = dom_event.plainTarget(ev) orelse return;
    const id = dom_event.datasetUp(target, "tagColor") orelse return;
    defer zx.allocator.free(id);
    const val = target.getAlloc(js.String, zx.allocator, "value") catch return;
    defer zx.allocator.free(val);
    tag_store.global.setColor(id, val, "") catch |err| {
        log.err("tag colour failed: {s}", .{@errorName(err)});
        return;
    };
    reading_prefs.scheduleSave();
}

const zx = @import("zx");
const std = @import("std");
const js = zx.client.js;

const tag_store = @import("./tag_store.zig");
const card_editor = @import("./card_editor.zig");
const char_store = @import("./character_store.zig");
const reading_prefs = @import("../chat/reading_prefs.zig");
const regions = @import("../shell/regions.zig");
const dom_event = @import("../platform/dom_event.zig");

const alloc = char_store.page_gpa;
const log = std.log.scoped(.tags);
