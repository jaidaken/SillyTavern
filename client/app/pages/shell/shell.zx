// The Shell region: top bar, the top-bar drawers, and the left/right side-panel docks. One of the
// three sibling client components mounted by page.zx (Shell, MessageLog, Composer), each with its
// own SSR marker and render boundary. #shell is display:contents in the CSS so its children lay out
// directly in #chat-root's grid (docks flank the centre column), keeping the regions DOM-disjoint
// siblings rather than nesting one client component inside another (which would collapse to
// lockstep re-render). A ui panel/motion mutation calls regions.bumpShell(), which re-renders only
// this region; MessageLog and Composer are untouched, so composer text, caret, and scroll survive.
pub fn Shell(ctx: *zx.ComponentCtx(void)) zx.Component {
    regions.shell = ctx.state(u32, 0);
    instrument.bumpShell();
    return (
        // The dismiss surface, not a control: a click that lands anywhere but inside the panel or on
        // the drawer buttons closes the open panel, and Escape does the same from the keyboard (the
        // job the glue's document listener used to hold, now owned by ui.zig). It is bound on the
        // three hydrated region roots, here and in MessageLog and Composer, because the SSR page
        // root carries no client handler. The div itself gains no behaviour, so it needs no role.
        // The class attribute is Zig-computed motion STATE (motion-on / motion-off / nothing), which
        // the interaction gate reads back off #shell, so it cannot also carry utilities. Its one
        // style, display:contents, stays in the stylesheet.
        // allow-div-onclick: region-level dismiss surface, keyboard parity via the Escape handler
        <div @allocator={ctx.allocator} id="shell" class={ui.motionClass()} onclick={ui.onPageClick} onkeydown={ui.onPageKey}>
            <TopBar key="topbar" />
            <EdgeTabs key="edgetabs" />
            // Two ALWAYS-PRESENT slots, one a side, rather than two conditional panels. The slots are
            // display:contents, so the panel inside each still lays out directly on #chat-root's grid
            // and nothing about the layout changes; what changes is that #shell's child list is a
            // fixed five, in a fixed order, whatever is open.
            //
            // That is the whole fix for the lost scroll position. Rendered conditionally, the child
            // list SHRANK when a side closed, so opening the left dock pushed the right one from
            // index 2 to index 3; the keyed reconciler answered that by MOVING the right <aside>
            // (insertBefore), and a DOM node that is detached and reattached comes back with its
            // scrollTop at zero. With the slots fixed, no reconcile pass ever moves a panel node, so
            // the right dock keeps its scroll (and its entry animation) while the left one opens.
            <div class="contents" key="dock-left">
                {if (ui.openOn(.left)) |p| (
                    <SidePanel panel={p} />
                )}
            </div>
            <div class="contents" key="dock-right">
                {if (ui.openOn(.right)) |p| (
                    <SidePanel panel={p} />
                )}
            </div>
            // The two top-bar CARDS, mounted here rather than beside the buttons that own them.
            // #topbar carries z-20, which makes it a stacking context and caps every descendant
            // inside it: a card nested there paints under the z-40 docks however high its own
            // z-index is, and a click aimed at it lands on the dock behind. Mounted out here they
            // compete globally at z-70 and sit over both dock layers. LAST in the child list so
            // they are last in paint order too, which settles it even between equal z-indexes.
            <NotifyPopover key="notify-popover" />
            <SysPopover key="sys-popover" />
        </div>
    );
}

const zx = @import("zx");
const ui = @import("../nav/ui.zig");
const regions = @import("./regions.zig");
const instrument = @import("../platform/instrument.zig");
const TopBar = @import("./topbar.zx").TopBar;
const SidePanel = @import("../nav/sidepanel.zx").SidePanel;
const EdgeTabs = @import("../nav/edgetabs.zx").EdgeTabs;
const NotifyPopover = @import("../notify/notify_bell.zx").NotifyPopover;
const SysPopover = @import("../nav/sysmenu.zx").SysPopover;
