// The top bar: the wordmark, and three app-wide controls at the right edge.
//
// The 13-icon drawer row that used to fill this bar is GONE (rework section 2, CLEAN BASE): thirteen
// unlabelled monochrome glyphs of equal weight was the thing that read as flattened. What is here
// instead is the irreducible set - backend state, notifications, system - with every PANEL still
// reached from the two edge tabs (edgetabs.zx) or from the system card's own switcher.
//
// These render the trigger BUTTONS only. Both cards mount in shell.zx, outside this header, because
// the `z-20` below makes the bar a stacking context that would cap them under the docks.
pub fn TopBar(allocator: zx.Allocator) zx.Component {
    return (
        <header
            @allocator={allocator}
            id="topbar"
            class="topbar"
        >
            <h1
                class="wordmark font-serif"
                aria-label="SillyTavern beta"
            >
                <span class="shell-topbar-part-2" aria-hidden="true">SillyTavern</span>
                <span class="wordmark-short" aria-hidden="true">ST</span>
                <span
                    class="beta-badge"
                    aria-hidden="true"
                >
                    <span class="shell-topbar-part-2">beta</span>
                    <span class="beta-badge-short">β</span>
                </span>
            </h1>
            // The two app-wide affordances live at the bar's right edge: notifications, then the system
            // gear. Both render their trigger button in this flex (so they align in the bar) and their
            // own popover as a fixed overlay that drops from below the bar (notify_bell.zx / sysmenu.zx).
            <div class="topbar-controls">
                <StatusIndicator />
                <NotifyBell />
                <SysMenu />
            </div>
        </header>
    );
}

const StatusIndicator = @import("../setup/status_indicator.zx").StatusIndicator;
const NotifyBell = @import("../notify/notify_bell.zx").NotifyBell;
const SysMenu = @import("../nav/sysmenu.zx").SysMenu;
const zx = @import("zx");
