// The undo surfaces (C4), both rendered at the MessageLog region root so they escape the `.mes`
// paint containment (content-visibility) that would clip an in-message popover, and so their clicks
// reach the one undo handler (undo.onLogClick). Neither is a ui.panels drawer: undo is a per-chat
// action, not a global topbar tool, so staying out of the catalogue leaves the 9-panel mobile gate
// intact. UndoVersions is a fixed popover anchored under the clicked control; UndoSnapshots is a
// bottom sheet from the composer Options button. Both carry id="undo-surface" for focus + dismiss.

/// Per-message version history: a fixed popover placed at the anchor captured from the control.
pub fn UndoVersions(allocator: zx.Allocator) zx.Component {
    return (
        <div
            @allocator={allocator}
            id="undo-surface"
            tabindex="-1"
            role="dialog"
            aria-label="Message history"
            style={undo.anchorStyle(allocator, store.undo.anchor_top, store.undo.anchor_right)}
            class={if (store.undo.closing) versions_out else versions_in}
        >
            <div class="undo-ver-head">
                <h3 class="undo-ver-title">Earlier versions</h3>
                <button
                    type="button"
                    class="icon undo-ver-refresh"
                    data-icon="close"
                    data-undo-close="1"
                    aria-label="Close history"
                ></button>
            </div>
            <p class="undo-ver-hint">Saved snapshots, last 50. Not every keystroke: two edits within ten seconds can merge into one.</p>
            { if (store.undo.busy) (
                <p class="undo-note">Loading history...</p>
            ) else if (store.undo.note.len > 0) (
                <p class="undo-note">{store.undo.note}</p>
            ) else (
                <ul class="undo-ver-list">
                    { for (store.undo.versions.items) |v| (
                        <li class="undo-ver-row">
                            <div class="undo-ver-preview font-serif">{v.mes}</div>
                            <div class="undo-ver-foot">
                                <span class="undo-ver-time">{undo.fmtTs(allocator, v.backup_ts)}</span>
                                <button
                                    type="button"
                                    class="undo-ver-restore"
                                    data-undo-restore={v.backup_ts}
                                    data-undo-kind="version"
                                >Restore</button>
                            </div>
                        </li>
                    )}
                </ul>
            )}
        </div>
    );
}

/// Whole-chat snapshot picker: a bottom sheet with a full-screen backdrop that dismisses on an
/// outside click (target outside #undo-surface, so undo.onLogClick closes it).
pub fn UndoSnapshots(allocator: zx.Allocator) zx.Component {
    return (
        <div
            @allocator={allocator}
            class="undo-snap-surface"
        >
            <div
                id="undo-surface"
                tabindex="-1"
                role="dialog"
                aria-label="Chat snapshots"
                class={if (store.undo.closing) snaps_out else snaps_in}
            >
                <div class="undo-snap-head">
                    <h2 class="undo-snap-title">Chat snapshots</h2>
                    <button
                        type="button"
                        class="icon undo-snap-refresh"
                        data-icon="close"
                        data-undo-close="1"
                        aria-label="Close snapshots"
                    ></button>
                </div>
                <div class="undo-snap-body">
                    <p class="undo-snap-hint">Restore the whole chat to an earlier save. Saved snapshots, last 50, not every keystroke: two edits within ten seconds can merge into one.</p>
                    { if (store.undo.busy) (
                        <p class="undo-note">Loading snapshots...</p>
                    ) else if (store.undo.note.len > 0) (
                        <p class="undo-note">{store.undo.note}</p>
                    ) else (
                        <ul class="undo-snap-list">
                            { for (store.undo.snapshots.items) |s| (
                                <li class="undo-snap-row">
                                    <div class="undo-snap-preview font-serif">{s.last_mes_preview}</div>
                                    <div class="undo-snap-foot">
                                        <div class="undo-snap-meta">
                                            <span class="undo-ver-time">{undo.fmtTs(allocator, s.backup_ts)}</span>
                                            <span class="undo-snap-size">{undo.snapMeta(allocator, s)}</span>
                                        </div>
                                        <div class="undo-snap-actions">
                                            <button
                                                type="button"
                                                class="undo-snap-restore"
                                                data-undo-restore={s.backup_ts}
                                                data-undo-kind="deleted"
                                            >Recover deleted</button>
                                            <button
                                                type="button"
                                                class="undo-snap-delete"
                                                data-undo-restore={s.backup_ts}
                                                data-undo-kind="snapshot"
                                            >Restore</button>
                                        </div>
                                    </div>
                                </li>
                            )}
                        </ul>
                    )}
                </div>
            </div>
        </div>
    );
}

// Both undo surfaces drop in on `drawer-in` and fade out on `drawer-out`, dropping pointer events
// while they leave. Literals so the tailwind scanner generates the animate-* utilities; store.undo
// keeps `mode` through the fade so the mount survives until the timer commits.
const versions_common = "undo-ver-btn";
const versions_in = versions_common ++ " chat-versions-in";
const versions_out = versions_common ++ " chat-versions-out";
const snaps_common = "undo-snap-btn";
const snaps_in = snaps_common ++ " chat-snaps-in";
const snaps_out = snaps_common ++ " chat-snaps-out";

const zx = @import("zx");
const store = @import("../platform/store.zig");
const undo = @import("./undo.zig");
