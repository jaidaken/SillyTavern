// The notification bell: a top-bar button, and the card it opens.
//
// THE COMPONENT IS DELIBERATELY SPLIT IN TWO, and that split is the whole point of this file. The
// button renders inside the top bar (topbar.zx); the card renders as a sibling of the docks
// (shell.zx), NOT next to its own button. #topbar carries `z-20`, which makes it a stacking context,
// and a stacking context CAPS every descendant: a card nested inside it could ask for z-[70] and
// still paint under a z-40 side dock, because the whole bar is competing at 20. That is not a
// theoretical ordering nit - it made a click at the centre of the open card land on the dock behind
// it. Rendering the card outside the bar is what lets its z-index mean what it says.
//
// The button is permanent: no edge reveal, no dock offset, no proximity fade. Only the unread COUNT
// comes and goes, as a chip on the corner.
pub fn NotifyBell(allocator: zx.Allocator) zx.Component {
    return (
        <button
            @allocator={allocator}
            id="notify-bell"
            type="button"
            class={bellClass()}
            data-icon={if (state.isOpen()) "close" else "bell"}
            aria-label={state.buttonLabel(allocator)}
            aria-haspopup="dialog"
            aria-expanded={state.expandedStr()}
            // Only while the card exists: aria-controls pointing at an absent id is a broken
            // reference, which is the gear's rule too.
            aria-controls={if (state.isMounted()) "notify-popover" else ""}
            onclick={menus.onBell}
            onkeydown={state.onKey}
        >
            {if (state.hasCount()) (
                <span id="notify-count" class={count_chip} aria-hidden="true">{state.countText(allocator)}</span>
            )}
        </button>
    );
}

/// The card. Mounted by shell.zx OUTSIDE the top bar (see the note above) so its z-index outranks
/// the docks it drops over.
pub fn NotifyPopover(allocator: zx.Allocator) zx.Component {
    return (
        <div @allocator={allocator} class="notify-popover-mount">
            {if (state.isMounted()) (
                <div
                    id="notify-popover"
                    class={if (state.isClosing()) popover_out else popover_in}
                    role="dialog"
                    aria-labelledby="notify-heading"
                    onkeydown={state.onKey}
                >
                    <div class="notify-popover-head">
                        <h2
                            id="notify-heading"
                            class="notify-heading"
                        >Notifications</h2>
                        <button
                            type="button"
                            class="notify-popover-close"
                            data-icon="close"
                            aria-label="Close notifications"
                            onclick={state.onClose}
                        ></button>
                    </div>
                    <div class="notify-popover-scroll">
                        <NotificationsBody />
                    </div>
                </div>
            )}
        </div>
    );
}

// The gear's twin, so the pair reads as one set of bar controls rather than two unrelated buttons.
// `relative` anchors the count chip. It grows to the 44px tap minimum on a coarse pointer, which is
// what --topbar-h yields 3rem for on mobile: a 2.6rem bar could not hold a 44px target (WD35).
const bell_base = "notify-bell";

// Two literals rather than a computed string: the tailwind scanner reads .zx text, so a utility
// assembled in Zig is never generated. Open takes the accent because the bell is then the close
// affordance, exactly as an open side's tab is.
const bell_idle = bell_base ++ " text-muted";
const bell_open = bell_base ++ " text-accent";

fn bellClass() []const u8 {
    return if (state.isOpen()) bell_open else bell_idle;
}

// The count sits on the corner AWAY from the gear, so a two-digit badge never crowds the button
// beside it. Amber is the single colour this theme spends on a live signal. aria-hidden because the
// button's own name already says how many are unread, and a screen reader should hear that sentence
// once, not a bare digit after it (WD38).
// Inset 2px, not 4px: a 44px button in a 48px bar leaves only 2px above it, and the wider offset put
// the badge over the bar's own top edge.
const count_chip = "notify-count-chip";

// Dropped from under the bar's right edge, capped in height with its own scroll so fifty
// notifications cannot grow a card taller than the window. No shadow: depth in this theme is carried
// on borders (WD16). z-[70] clears both dock layers (z-40 desktop, z-50 mobile full-screen), which
// only holds because shell.zx mounts this outside #topbar's stacking context.
// Two literals rather than a computed string, for the same scanner reason as the bell classes: the
// card drops in on `drawer-in` and lifts back out on `drawer-out`, dropping its pointer events while
// it fades so a click reaches the page behind it.
const popover_base = "notify-popover";
const popover_in = popover_base ++ " animate-drawer-in";
const popover_out = popover_base ++ " animate-drawer-out pointer-events-none";

const zx = @import("zx");
const state = @import("./notify_bell_state.zig");
const menus = @import("../shell/topbar_menus.zig");
const NotificationsBody = @import("./notifications_body.zx").NotificationsBody;
